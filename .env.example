# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database ----------
# Leave DATABASE_URL empty for local SQLite (no setup needed).
# For Docker/production set it to PostgreSQL, e.g.:
# DATABASE_URL=postgres://apiforge:apiforge@db:5432/apiforge
DATABASE_URL=

# ---------- Redis (optional, enables shared rate-limits + websockets across workers) ----------
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Gateway ----------
# Public base URL used when rendering "gateway_url" for an endpoint.
GATEWAY_BASE_URL=http://localhost:8000
# Allow forwarding to private/loopback upstream targets (dev only).
ALLOW_PRIVATE_UPSTREAM=true

# ---------- Single-container deployments (Docker / Liara) ----------
# Serve the built React bundle from Django. Auto-detected in the production
# image; set explicitly for other setups.
SERVE_SPA=false
# Run `migrate` / `collectstatic` / `seed_demo` on container start.
RUN_MIGRATIONS=true
COLLECT_STATIC=true
SEED_DEMO=false
# Create an admin account on first boot (development convenience only).
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_PASSWORD=

# ---------- Frontend (Vite) ----------
# Empty => use the dev proxy (/api, /gateway, /ws) which is the recommended setup.
VITE_API_URL=
