# Line endings matter for the container: `docker/entrypoint.sh` starts with a
# shebang, and a CRLF there makes the image fail with "not found".
# Keep LF in the working tree on every platform, including Windows.
* text=auto eol=lf

*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Never touch binary assets.
*.svg binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
